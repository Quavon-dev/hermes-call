[Unit]
Description=Hermes Call hermes-call-tts (German speech on 127.0.0.1, no network access)
Documentation=https://github.com/quavon-dev/hermes-call
After=network.target

[Service]
Type=simple
User=hermes-call-tts
Group=hermes-call-tts
EnvironmentFile=/etc/hermes-call-tts/tts.env
ExecStart=/opt/hermes-call-tts/venv/bin/python -m hermescall_tts --host 127.0.0.1 --port ${PORT} --voices ${VOICES} --threads ${THREADS} --models /var/lib/hermes-call-tts/models
Environment=PYTHONPATH=/opt/hermes-call-tts/app:/opt/hermes-call-tts/src/kokoro:/opt/hermes-call-tts/src/misaki
Environment=PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 TRANSFORMERS_OFFLINE=1
TimeoutStartSec=180
Restart=on-failure
RestartSec=5

IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/hermes-call-tts
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
PrivateIPC=yes
TasksMax=64
LimitNOFILE=256
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077
MemoryMax=2G

[Install]
WantedBy=multi-user.target

[Unit]
Description=Hermes Call: update TURN external IP after a public IP change
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/hermescall-relay/relay/install.sh refresh-ip
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/hermescall-relay
